# Oura OAuth2 app credentials from the Oura developer portal (cloud.ouraring.com).
# Never commit real secrets.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Optional explicit OAuth redirect URI. Defaults to
# <request origin>/api/integrations/oura/callback; must match the URI registered with Oura.
OURA_REDIRECT_URI=

# Optional path for the persisted Oura OAuth token file.
# Defaults to .data/oura-tokens.json.
OURA_TOKEN_PATH=

# Server-side Oura Personal Access Token. Fallback when no OAuth tokens are stored.
# Never commit real secrets.
OURA_PAT=

# Bearer token for OpenClaw-safe health endpoints under /api/openclaw/health.
# Use a long random value locally; never commit real secrets.
OPENCLAW_HEALTH_TOKEN=

# Legacy/future ingestion key for trusted local/OpenClaw or mobile bridge clients.
OPENCLAW_INGESTION_TOKEN=

# Withings smart scale integration. Obtain via Withings Developer Portal OAuth flow.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# Short-lived OAuth access token for Withings Measure API calls from the webhook handler.
WITHINGS_ACCESS_TOKEN=

# Optional HMAC-SHA256 secret to verify Withings webhook payload signatures.
# If set, the webhook handler rejects requests with invalid x-withings-signature headers.
WITHINGS_HMAC_SECRET=
